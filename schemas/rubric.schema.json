{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onprs.github.io/schemas/rubric.schema.json",
  "title": "OnprsBench Dataset Rubric",
  "description": "单个任务 rubric.yaml 的 schema（Dataset Protocol v1）。维度权重之和必须为 1.0（由校验器检查）。",
  "type": "object",
  "required": ["rubric_version", "dimensions"],
  "additionalProperties": false,
  "properties": {
    "rubric_version": { "type": "integer", "const": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "weight", "description", "anchors"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "description": { "type": "string", "minLength": 1 },
          "anchors": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["score", "description"],
              "additionalProperties": false,
              "properties": {
                "score": { "type": "number", "minimum": 0, "maximum": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
